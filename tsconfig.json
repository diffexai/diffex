{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"*": ["./*"],
			"#evolution": ["./packages/evolution/src/index.ts"],
			"#harness-trace": ["./packages/harness-trace/src/index.ts"],
			"@diffexai/diffex-evolution": ["./packages/evolution/src/index.ts"],
			"@diffexai/diffex-harness-state": ["./packages/harness-state/src/index.ts"],
			"@diffexai/diffex-harness-trace": ["./packages/harness-trace/src/index.ts"],
			"@diffexai/diffex-telemetry": ["./packages/telemetry/src/index.ts"],
			"@diffexai/diffex-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@diffexai/diffex-ai": ["./packages/ai/src/index.ts"],
			"@diffexai/diffex-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@diffexai/diffex-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@diffexai/diffex-ai/dist/*": ["./packages/ai/src/*"],
			"@diffexai/diffex-agent-core": ["./packages/agent/src/index.ts"],
			"@diffexai/diffex-agent-core/node": ["./packages/agent/src/node.ts"],
			"@diffexai/diffex-agent-core/session/testing": [
				"./packages/agent/src/harness/session/testing/index.ts"
			],
			"@diffexai/diffex-agent-core/*": ["./packages/agent/src/*"],
			"@diffexai/diffex-session-backend-sqlite-node": ["./packages/session-backends/sqlite-node/src/index.ts"],
			"@diffexai/diffex": ["./packages/coding-agent/src/index.ts"],
			"@diffexai/diffex/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@diffexai/diffex/*": ["./packages/coding-agent/src/*"],
			"@diffexai/diffex-protocol": ["./packages/protocol/src/index.ts"],
			"@diffexai/diffex-protocol/*": ["./packages/protocol/src/*"],
			"@diffexai/diffex-client": ["./packages/client/src/index.ts"],
			"@diffexai/diffex-client/websocket": ["./packages/client/src/websocket.ts"],
			"@diffexai/diffex-client/*": ["./packages/client/src/*"],
			"@diffexai/diffex-server": ["./packages/server/src/index.ts"],
			"@diffexai/diffex-server/testing": ["./packages/server/src/testing/index.ts"],
			"@diffexai/diffex-server/websocket": [
				"./packages/server/src/transports/websocket/index.ts"
			],
			"@diffexai/diffex-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@diffexai/diffex-tui": ["./packages/tui/src/index.ts"],
			"@diffexai/diffex-tui/*": ["./packages/tui/src/*"],
			"@diffexai/diffex-agent-old": ["./packages/agent-old/src/index.ts"],
			"@diffexai/diffex-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["packages/*/src/**/*", "packages/*/test/**/*", "packages/session-backends/*/src/**/*", "packages/session-backends/*/test/**/*", "packages/coding-agent/examples/**/*"],
	"exclude": ["**/dist/**"]
}
