{
	"name": "@diffexai/diffex-session-backend-sqlite-node",
	"version": "0.4.1",
	"description": "Node sqlite session backend for @diffexai/diffex-agent-core sessions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-NOTICES.txt",
		"distribution-components.json",
		"distribution-files.json"
	],
	"scripts": {
		"clean": "node -e \"import('node:fs/promises').then(fs=>fs.rm('dist',{recursive:true,force:true}))\"",
		"build": "tsgo -p tsconfig.build.json && node ./scripts/prepare-dist.mjs copy-sqlite-migrations",
		"test": "vitest --run",
		"coverage": "vitest --run --coverage",
		"prepublishOnly": "npm run clean && npm run build",
		"prepack": "node ../../../scripts/prepare-distribution.mjs packages/session-backends/sqlite-node"
	},
	"author": "DiffexAI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/session-backends/sqlite-node"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@diffexai/diffex-ai": "^0.4.1",
		"@diffexai/diffex-agent-core": "^0.4.1"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "4.1.12",
		"vitest": "4.1.12"
	},
	"private": true
}
