{
	"name": "@diffexai/diffex-server",
	"version": "0.4.1",
	"description": "Experimental server package for Diffex",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./testing": {
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./unix": {
			"types": "./dist/transports/unix/index.d.ts",
			"import": "./dist/transports/unix/index.js"
		},
		"./websocket": {
			"types": "./dist/transports/websocket/index.d.ts",
			"import": "./dist/transports/websocket/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-NOTICES.txt",
		"distribution-components.json",
		"distribution-files.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build",
		"prepack": "node ../../scripts/prepare-distribution.mjs packages/server"
	},
	"keywords": [
		"diffex",
		"server"
	],
	"author": "DiffexAI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@diffexai/diffex-ai": "^0.4.1",
		"@diffexai/diffex-protocol": "^0.4.1",
		"ws": "8.22.0"
	},
	"devDependencies": {
		"@types/ws": "8.18.2",
		"shx": "0.4.0",
		"vitest": "4.1.12"
	},
	"private": true
}
