{
	"name": "@diffexai/diffex-agent-core",
	"version": "0.3.2",
	"description": "General-purpose agent with transport abstraction, state management, and attachment support",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./session/testing": {
			"types": "./dist/harness/session/testing/index.d.ts",
			"import": "./dist/harness/session/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-NOTICES.txt",
		"distribution-components.json",
		"distribution-files.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"generate-telemetry-docs": "node scripts/generate-telemetry-docs.ts",
		"check:telemetry-docs": "node scripts/generate-telemetry-docs.ts --check",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"test:harness": "vitest --run --config vitest.harness.config.ts",
		"coverage:harness": "vitest --run --config vitest.harness.config.ts --coverage",
		"prepublishOnly": "npm run build",
		"prepack": "node ../../scripts/prepare-distribution.mjs packages/agent"
	},
	"dependencies": {
		"@diffexai/diffex-ai": "^0.3.2",
		"@diffexai/diffex-telemetry": "^0.3.2",
		"diff": "9.0.0",
		"ignore": "7.0.14",
		"typebox": "1.4.3",
		"yaml": "2.9.1"
	},
	"keywords": [
		"ai",
		"agent",
		"llm",
		"transport",
		"state-management"
	],
	"author": "Mario Zechner",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "4.1.12",
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	},
	"private": true
}
