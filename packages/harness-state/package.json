{
	"name": "@diffexai/diffex-harness-state",
	"version": "0.4.1",
	"description": "Persistent harness state schema and bundle storage for Diffex",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-NOTICES.txt",
		"distribution-components.json",
		"distribution-files.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx rm -rf dist/default",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build",
		"prepack": "node ../../scripts/prepare-distribution.mjs packages/harness-state"
	},
	"keywords": [
		"diffex",
		"harness",
		"versioning"
	],
	"author": "DiffexAI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/harness-state"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"proper-lockfile": "4.1.2",
		"typebox": "1.4.3",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@types/proper-lockfile": "4.1.4",
		"shx": "0.4.0",
		"vitest": "4.1.12"
	},
	"private": true
}
