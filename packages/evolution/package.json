{
	"name": "@diffexai/diffex-evolution",
	"version": "0.4.0",
	"description": "Private evolution pipeline contracts and orchestration for Diffex",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-NOTICES.txt",
		"distribution-components.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"author": "DiffexAI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/evolution"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@diffexai/diffex-harness-state": "^0.4.0",
		"@diffexai/diffex-harness-trace": "^0.4.0",
		"proper-lockfile": "4.1.2"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@types/proper-lockfile": "4.1.4",
		"shx": "0.4.0",
		"typebox": "1.4.3",
		"vitest": "4.1.12"
	}
}
