{
	"name": "@diffexai/diffex-coding-agent-server",
	"version": "0.2.1",
	"description": "Hosted Diffex protocol service backed by the Diffex coding-agent runtime",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"diffex-runtime-server": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-NOTICES.txt",
		"distribution-components.json",
		"distribution-files.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build",
		"prepack": "node ../../scripts/prepare-distribution.mjs packages/coding-agent-server"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/coding-agent-server"
	},
	"dependencies": {
		"@diffexai/diffex": "^0.2.1",
		"@diffexai/diffex-protocol": "^0.2.1",
		"@diffexai/diffex-server": "^0.2.1"
	},
	"devDependencies": {
		"@diffexai/diffex-client": "^0.2.1",
		"shx": "0.4.0",
		"vitest": "4.1.9",
		"ws": "8.21.0"
	},
	"private": true
}
