{
	"name": "@diffexai/diffex-client",
	"version": "0.2.0",
	"description": "Transport-neutral client for remote Diffex sessions over framed CBOR bytes",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./unix": {
			"types": "./dist/unix.d.ts",
			"import": "./dist/unix.js"
		},
		"./websocket": {
			"types": "./dist/websocket.d.ts",
			"import": "./dist/websocket.js"
		},
		"./cloud": {
			"types": "./dist/cloud.d.ts",
			"import": "./dist/cloud.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"test": "vitest --run",
		"typecheck": "tsgo -p tsconfig.test.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"diffex",
		"client",
		"protocol",
		"cbor",
		"binary"
	],
	"author": "DiffexAI",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/client"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@diffexai/diffex-protocol": "^0.2.0"
	},
	"devDependencies": {
		"shx": "0.4.0",
		"vitest": "4.1.9"
	}
}
