{
	"name": "@diffexai/diffex-tui",
	"version": "0.3.3",
	"description": "Terminal User Interface library with differential rendering for efficient text-based applications",
	"type": "module",
	"main": "dist/index.js",
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json",
		"build:native:darwin": "native/darwin/build.sh",
		"build:native:win32": "node native/win32/build.mjs",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"prepublishOnly": "npm run clean && npm run build",
		"prepack": "node ../../scripts/prepare-distribution.mjs packages/tui"
	},
	"files": [
		"dist/**/*",
		"native/win32/prebuilds/**/*.node",
		"native/win32/README.md",
		"native/darwin/prebuilds/**/*.node",
		"native/darwin/README.md",
		"README.md",
		"LICENSE",
		"NOTICE",
		"THIRD-PARTY-NOTICES.txt",
		"distribution-components.json",
		"distribution-files.json"
	],
	"keywords": [
		"tui",
		"terminal",
		"ui",
		"text-editor",
		"differential-rendering",
		"typescript",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/diffexai/diffex.git",
		"directory": "packages/tui"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"types": "./dist/index.d.ts",
	"dependencies": {
		"get-east-asian-width": "1.7.0",
		"marked": "18.1.1"
	},
	"devDependencies": {
		"@xterm/headless": "6.0.0",
		"chalk": "6.0.1"
	},
	"private": true
}
